# Alabaster theme for fish shell
# Based on https://github.com/tonsky/vscode-theme-alabaster

set --global fish_color_normal 000000
set --global fish_color_command 325CC0
set --global fish_color_keyword 325CC0
set --global fish_color_quote 448C27
set --global fish_color_redirection 7A3E9D
set --global fish_color_end 777777
set --global fish_color_error AA3731
set --global fish_color_param 000000
set --global fish_color_valid_path --underline
set --global fish_color_operator 777777
set --global fish_color_escape 777777
set --global fish_color_comment AA3731
set --global fish_color_selection --background=BFDBFE
set --global fish_color_search_match --background=BFDBFE
